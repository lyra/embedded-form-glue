{
  "name": "@lyracom/embedded-form-glue",
  "version": "2.0.0",
  "description": "Lyra embedded form glue",
  "main": "lib/index.js",
  "scripts": {
    "build": "webpack",
    "prepublish": "tsc -p tsconfig.lib.json && prettier --write \"lib/**/*.js\"",
    "lint": "eslint --ext .ts app && eslint --ext .js lib",
    "lintfix": "eslint --fix --ext .ts app && eslint --fix --ext .js lib",
    "prettier": "prettier --write \"app/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npx playwright test tests/e2e/specs",
    "test:unit": "vitest",
    "examples:build": "sh tests/scripts/build_examples.sh",
    "examples:prepare": "sh tests/scripts/prepare_examples.sh",
    "examples:serve": "sh tests/scripts/start_examples.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyra/embedded-form-glue.git"
  },
  "keywords": [
    "javascript",
    "embedded",
    "form",
    "lyra",
    "glue"
  ],
  "author": "Lyra Network",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lyra/embedded-form-glue/issues"
  },
  "homepage": "https://github.com/lyra/embedded-form-glue#readme",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.23.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "gulp": "4.0.2",
    "gulp-debug": "3.2.0",
    "gulp-replace": "1.1.3",
    "gulp-run": "1.7.0",
    "http-server": "14.1.1",
    "prettier": "2.7.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.3.3",
    "vitest": "^0.34.6",
    "webpack": "5.74.0",
    "webpack-cli": "4.10.0"
  }
}
